{
  "model": "opus",
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(echo *)",
      "Bash(wc *)",
      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(git *)",
      "Bash(uv *)",
      "Bash(pip *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(curl https://*)",
      "WebSearch",
      "WebFetch(*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(* | sh)",
      "Bash(* | bash)",
      "Bash(git * --force)",
      "Bash(git * --hard)",
      "Bash(git clean *)",
      "Bash(rm *)",
      "Bash(dd *)",
      "Bash(mkfs *)"
    ]
  }
}